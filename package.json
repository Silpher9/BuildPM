{
  "name": "buildpm",
  "version": "0.1.0",
  "private": true,
  "description": "Bouwdashboard bovenop een Obsidian-vault: de vault blijft de enige bron, het dashboard leest en schrijft er rechtstreeks in.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "demo": "VAULT_PATH=./demo-vault PROJECT_DIR=project NODE_ENV=development node server/index.js",
    "format": "prettier --write src server test"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "markdown-it": "^14.3.3",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wouter": "^3.13.0"
  }
}

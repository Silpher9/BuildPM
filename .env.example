# Map van de Obsidian-vault en de projectmap daarbinnen
VAULT_PATH=/pad/naar/Obsidian Vault
PROJECT_DIR=schuur

# Server
PORT=3080
HOST=0.0.0.0

# Optioneel: pincode om het dashboard af te schermen
# BUILDPM_PIN=1234

# Optioneel: script dat het vault-manifest bijwerkt na een wijziging (relatief aan de vault; leeg = uit)
# MANIFEST_SCRIPT=_system/scripts/build_manifest.py

# Naam als bron bij besluiten vanuit het dashboard, en de centrale vragenlijst
# OWNER_NAME=Eigenaar
# QUESTIONS_FILE=01_Research/99_Vragen.md
